# --- Application ---
# The app reads DATABASE_URL (see app/database.py). Any other name is ignored
# and the app silently falls back to SQLite.
DATABASE_URL=postgresql+psycopg://pulsewatch:change-me@db:5432/uptime_monitor
SESSION_SECRET=replace-me-with-a-long-random-value

# --- Postgres container (used by the postgres image itself) ---
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uptime_monitor
